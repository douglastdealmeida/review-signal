{
  "manifest_version": 3,
  "name": "Review Signal",
  "version": "0.1.0",
  "description": "Highlights review patterns that may deserve a closer look.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Review Signal",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
